# Copy to `.env` (ignored by Git) and fill in. These values are PUBLIC by design: they ship inside the app.
# Never put secrets here (no API keys, no client secrets, no keystore passwords).

# Development: the local API over your LAN (http allowed only in development builds), e.g. http://192.168.1.20:5214
# Release builds require https.
EXPO_PUBLIC_API_URL=

# Auth0 Native application (HU-83)
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.flowtrim.dev
